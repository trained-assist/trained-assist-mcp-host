{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trained-assist-mcp-host-identity",
  "main": "src/worker-unified.mjs",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "MCP_TEST_PRINCIPAL_ID": "integration-telegram-ux-v1",
    "MCP_TEST_CATALOGUE_VERSION": "registry-fixture-catalogue-v1",
    "MCP_MODE": "human"
  },
  "d1_databases": [
    {
      "binding": "MCP_IDENTITY_DB",
      "database_name": "trained-assist-mcp-identity",
      "database_id": "identity-db-will-be-replaced-at-deploy"
    }
  ]
}